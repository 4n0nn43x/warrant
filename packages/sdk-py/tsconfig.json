{
  // Covers only `codegen/`: the rest of the package is Python. The generator
  // reaches into `../sdk-ts/src` and `../server/src` by relative import — that is
  // deliberate, it reads the source, not a `dist` that could be lagging behind.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["codegen/**/*.ts"]
}
