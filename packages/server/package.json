{
  "name": "@warrant/server",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gateway": "node --env-file-if-exists=../../.env --import tsx src/bin/gateway.ts",
    "settler": "node --env-file-if-exists=../../.env --import tsx src/bin/settler.ts",
    "open-warrant": "node --env-file-if-exists=../../.env --import tsx src/bin/open-warrant.ts",
    "register-agent": "node --env-file-if-exists=../../.env --import tsx src/bin/register-agent.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@warrant/core": "workspace:*",
    "hono": "^4.6.14",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
