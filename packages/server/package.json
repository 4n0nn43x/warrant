{
  "name": "@warrant/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gateway": "node --env-file-if-exists=../../.env --import tsx src/bin/gateway.ts",
    "settler": "node --env-file-if-exists=../../.env --import tsx src/bin/settler.ts",
    "open-warrant": "node --env-file-if-exists=../../.env --import tsx src/bin/open-warrant.ts",
    "open-via-gateway": "node --env-file-if-exists=../../.env --import tsx src/bin/open-via-gateway.ts",
    "register-agent": "node --env-file-if-exists=../../.env --import tsx src/bin/register-agent.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "warrant-core": "workspace:*",
    "hono": "^4.12.34",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "warrant-sdk": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
