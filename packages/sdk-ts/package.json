{
  "name": "warrant-sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Warrant TypeScript SDK \u2014 single source of tool definitions plus thin framework adapters",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./x402": {
      "types": "./dist/x402.d.ts",
      "default": "./dist/x402.js"
    },
    "./mpp": {
      "types": "./dist/mpp.d.ts",
      "default": "./dist/mpp.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "warrant-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4n0nn43x/warrant.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/4n0nn43x/warrant#readme",
  "bugs": {
    "url": "https://github.com/4n0nn43x/warrant/issues"
  },
  "keywords": [
    "ai-agents",
    "x402",
    "mpp",
    "langchain",
    "mcp",
    "ethereum",
    "base"
  ],
  "publishConfig": {
    "access": "public"
  }
}
