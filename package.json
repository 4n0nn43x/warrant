{
  "name": "warrant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Bonded execution for onchain agents — KeeperHub Agents Onchain hackathon",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:contracts": "cd contracts && forge test -vv",
    "fixtures": "tsx packages/core/scripts/gen-fixtures.ts",
    "faucet": "node --env-file-if-exists=.env --import tsx scripts/faucet-base-sepolia.ts",
    "verdicts:publish": "tsx scripts/publish-verdicts.ts"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.54.0",
    "@types/node": "^22.10.2",
    "warrant-core": "workspace:*",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@11.17.0"
}
