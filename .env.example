# ─── KeeperHub ───────────────────────────────────────────────────────────────
# Clé API scoped organisation. Jamais commitée.
KH_API_KEY=kh_xxxxxxxxxxxxxxxx
KH_BASE_URL=https://app.keeperhub.com

# ─── RPC ─────────────────────────────────────────────────────────────────────
# INDÉPENDANT de KeeperHub. Utiliser le même fournisseur pour exécuter et pour
# juger réintroduirait la circularité que tout le projet cherche à éviter.
BASE_RPC=https://mainnet.base.org
ETHEREUM_RPC=
# RPC publié dans chaque verdict, pour que n'importe qui puisse le rejouer.
EVALUATOR_RPC=

# ─── Escrow ──────────────────────────────────────────────────────────────────
WARRANT_ESCROW_ADDRESS=
WARRANT_TREASURY=
# opener et settler DOIVENT être deux clés distinctes (invariant I10).
OPENER_PRIVATE_KEY=
SETTLER_PRIVATE_KEY=
FEE_BPS=250

# ─── Paiement ────────────────────────────────────────────────────────────────
X402_FACILITATOR=https://x402.org/facilitator
MPP_SECRET_KEY=
WARRANT_VAULT=

# ─── ERC-8004 ────────────────────────────────────────────────────────────────
# Le Settler ne doit être ni owner ni operator des agentId qu'il note, sinon
# giveFeedback révèrte (docs/10 § 4).
ERC8004_CHAIN=base
VERDICT_BASE_URI=https://warrant.sh/v/
