# Modèle de configuration. Copier en `.env` et remplir. Le `.env` n'est jamais
# commité ; ce fichier-ci ne contient aucun secret, seulement leur forme.
#
# ─── Convention de nommage ───────────────────────────────────────────────────
# Un nom canonique par variable, aucun alias : un binaire qui accepte deux
# orthographes finit par lire celle qui n'est pas renseignée.
#
#   préfixe  = le nom que le sous-système se donne lui-même —
#              `KH_` pour KeeperHub (sa CLI est `kh`, ses clés commencent par
#              `kh_`), `X402_`, `MPP_`, `ERC8004_`, et `WARRANT_` pour ce qui
#              appartient à ce dépôt.
#   suffixe  = le type de la valeur quand il est ambigu —
#              `_RPC` (point de terminaison JSON-RPC), `_URL` (service HTTP),
#              `_KEY` (secret), `_FILE` (chemin), `_CHAIN_ID`, `_BPS`.
#   adresses = nommées par leur **rôle**, jamais par leur type
#              (`WARRANT_BENEFICIARY`, `WARRANT_PAY_TO`, …) : le rôle est ce qui
#              se vérifie onchain, l'adresse ne fait que l'incarner.

# ─── KeeperHub ───────────────────────────────────────────────────────────────
# Clé API scoped organisation, préfixe `kh_`. Jamais commitée. Une clé `wfb_`
# est une clé webhook utilisateur : rejetée en 401 par les routes d'exécution.
KH_API_KEY=kh_xxxxxxxxxxxxxxxx
KH_BASE_URL=https://app.keeperhub.com

# ─── RPC ─────────────────────────────────────────────────────────────────────
# INDÉPENDANT de KeeperHub. Utiliser le même fournisseur pour exécuter et pour
# juger réintroduirait la circularité que tout le projet cherche à éviter.
BASE_RPC=https://mainnet.base.org
ETHEREUM_RPC=
# RPC publié dans chaque verdict, pour que n'importe qui puisse le rejouer.
EVALUATOR_RPC=

# ─── Escrow ──────────────────────────────────────────────────────────────────
WARRANT_ESCROW_ADDRESS=
# Chaînes connues du Gateway : 1, 8453, 11155111, 84532. Une chaîne absente de
# la table fait échouer le démarrage — ouvrir un mandat sur la mauvaise chaîne
# est irréversible.
WARRANT_ESCROW_CHAIN_ID=11155111
# RPC utilisé pour écrire et pour le contrôle de cohérence au démarrage. Vide →
# le RPC public par défaut de la chaîne, qui rate-limite vite.
WARRANT_ESCROW_RPC=
# Qui signe `open()` : `keeperhub` (défaut) ou `viem`.
#   keeperhub — l'`opener` onchain est le wallet de l'organisation KeeperHub et
#               l'ouverture est sponsorisée en gas (docs/transactions.md § 3) ;
#   viem      — l'`opener` est OPENER_PRIVATE_KEY, qui doit alors avoir du gas.
# Dans les deux cas le Gateway lit `opener()` onchain au démarrage et refuse de
# démarrer si ce qu'il s'apprête à utiliser n'est pas ce que le contrat attend.
WARRANT_ESCROW_PORT=keeperhub
WARRANT_TREASURY=
# Destinataire de la caution en cas de saisie — le propriétaire du capital.
# Ni la trésorerie (invariant I6 : une saisie ne rapporte rien à Warrant), ni
# le settler.
WARRANT_BENEFICIARY=
# opener et settler DOIVENT être deux clés distinctes (invariant I10).
# OPENER_PRIVATE_KEY n'est lue que si WARRANT_ESCROW_PORT=viem.
OPENER_PRIVATE_KEY=
SETTLER_PRIVATE_KEY=
FEE_BPS=250

# ─── Paiement ────────────────────────────────────────────────────────────────
X402_FACILITATOR=https://x402.org/facilitator
# Facultatif : certains facilitateurs exigent une clé.
X402_FACILITATOR_API_KEY=
# Secret de signature des Challenges MPP. Le projet le génère lui-même : il
# n'est distribué par personne et ne sert qu'à ce que le Gateway reconnaisse un
# Challenge qu'il a émis. Un par déploiement :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MPP_SECRET_KEY=
# Token de caution accepté par le règlement x402.
WARRANT_ASSET=
# Destinataire du règlement x402 : **l'escrow lui-même**. `open()` exige que les
# fonds soient déjà sur le contrat (`token.balanceOf(this) >= totalLocked`,
# WarrantEscrow.sol:131) — un coffre intermédiaire ajouterait un transfert de
# plus et une fenêtre pendant laquelle un mandat serait ouvert sans être financé.
WARRANT_PAY_TO=

# ─── ERC-8004 ────────────────────────────────────────────────────────────────
# Le Settler ne doit être ni owner ni operator des agentId qu'il note, sinon
# giveFeedback révèrte (docs/10 § 4).
ERC8004_CHAIN=base
VERDICT_BASE_URI=https://raw.githubusercontent.com/<org>/<repo>/<branche>/verdicts/

# Destinations autorisees pour toute categorie SORTANTE (transfer, approve,
# withdraw, borrow). OBLIGATOIRE, liste separee par des virgules : sans elle le
# Gateway refuse de demarrer, et c'est voulu. Une categorie sortante sans
# allowlist produisait une post-condition sans check de destination, donc un
# transfert vers une adresse quelconque etait honore.
WARRANT_ALLOWED_DEST=
# Tokens surveilles en plus de la cible pour les actions non classifiees.
WARRANT_WATCHED_TOKENS=

# ─── Settler (daemon de règlement) ───────────────────────────────────────────
# Journal des mandats, écrit par le Gateway et suivi par le Settler. C'est la
# seule chose que la chaîne ne peut pas rendre : `WarrantOpened` ne porte que
# `conditionHash` / `actionHash`, et un hash n'est pas inversible. Le Settler ne
# le croit pas pour autant : il recalcule les deux engagements et refuse
# d'évaluer si le journal diverge de la chaîne (voir src/journal.ts).
WARRANT_JOURNAL_FILE=.warrant/warrants.jsonl
# Répertoire des documents de verdict, servis tels quels par le Settler à
# VERDICT_BASE_URI. Le fichier écrit EST la forme canonique JCS qui a été
# hachée : ne jamais le reformater.
# Chemin ABSOLU. Un chemin relatif se resout au repertoire courant du process,
# et le settler n'est pas lance depuis la racine : des verdicts engages onchain
# se retrouveraient hors du depot, invisibles pour un tiers.
VERDICT_DIR=
# Port du serveur de verdicts en lecture seule. VERDICT_BASE_URI doit désigner
# ce service depuis l'extérieur — c'est cette URI qui part onchain dans
# `feedbackURI`, et une URI qui ne résout pas rend le verdict invérifiable.
SETTLER_PORT=8403
SETTLER_INTERVAL_MS=15000
# Un seul tour puis sortie. Pour un cron, ou pour éprouver une configuration.
SETTLER_ONCE=
# Mode observation : décide, publie, n'écrit rien onchain.
SETTLER_DRY_RUN=
# Premier bloc balayé. Vide → tête − SETTLER_LOOKBACK_BLOCKS : un mandat vit au
# plus MAX_DURATION = 7 jours, donc rien de plus ancien ne peut être encore Open.
SETTLER_FROM_BLOCK=
SETTLER_LOOKBACK_BLOCKS=60000
# Fenêtre d'eth_getLogs. Les nœuds publics plafonnent la plage (drpc : 10 000).
SETTLER_LOG_CHUNK=9000
# Profondeur du sondage d'archive au démarrage. Le Settler refuse de démarrer si
# le RPC ne sait pas lire à ce bloc : juger sur un nœud non-archive produirait
# des verdicts irrejouables.
SETTLER_ARCHIVE_PROBE_DEPTH=5000
SETTLER_CONFIRMATION_TIMEOUT_MS=120000

# Table `adresse d'agent → agentId` ERC-8004, en JSON. L'IdentityRegistry
# n'expose aucune recherche inverse par propriétaire. Absente, le mandat est
# réglé et le verdict publié : seule l'inscription ERC-8004 est sautée.
ERC8004_AGENT_IDS_FILE=
# Chaîne d'inscription. Doit être celle de l'escrow : le Settler ne signe que
# sur une chaîne à la fois. Vide → WARRANT_ESCROW_CHAIN_ID.
ERC8004_CHAIN_ID=
# Adresses des registres. Vides → les adresses déterministes de @warrant/core,
# variante testnet ou mainnet selon la chaîne.
ERC8004_IDENTITY=
ERC8004_REPUTATION=
# Toute chaîne hors de la liste des testnets connus est traitée comme un
# mainnet et l'écriture y est REFUSÉE sans ce drapeau explicite.
ERC8004_ALLOW_MAINNET=
ERC8004_DISABLED=
# « toutes les N exécutions ou toutes les 24 h » : une saisie s'inscrit
# immédiatement, un mandat honoré part en lot.
ERC8004_BATCH_SIZE=25
ERC8004_BATCH_MAX_AGE_MS=86400000

# ─── Coinbase Developer Platform ──────────────────────────────────────────────
# Necessaire pour DEUX choses, et c'est pourquoi le compte vaut la peine :
#   1. le faucet programmatique Base Sepolia (0,1 ETH / 24 h, plus de l'USDC) ;
#   2. le facilitateur x402 MAINNET (api.cdp.coinbase.com/platform/v2/x402).
# Le facilitateur public x402.org ne sert que Base Sepolia : toute cible mainnet
# passe obligatoirement par CDP.
# A creer sur portal.cdp.coinbase.com. Secrets : jamais journalises.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
