# Configuration template. Copy to `.env` and fill it in. `.env` is never
# committed; this file holds no secret, only their shape.
#
# ─── Naming convention ───────────────────────────────────────────────────────
# One canonical name per variable, no alias: a binary that accepts two spellings
# ends up reading the one that was not filled in.
#
#   prefix    = the name the subsystem gives itself —
#               `KH_` for KeeperHub (its CLI is `kh`, its keys start with `kh_`),
#               `X402_`, `MPP_`, `ERC8004_`, and `WARRANT_` for what belongs to
#               this repository.
#   suffix    = the type of the value when it is ambiguous —
#               `_RPC` (JSON-RPC endpoint), `_URL` (HTTP service), `_KEY`
#               (secret), `_FILE` (path), `_CHAIN_ID`, `_BPS`.
#   addresses = named by their **role**, never by their type
#               (`WARRANT_BENEFICIARY`, `WARRANT_PAY_TO`, …): the role is what
#               gets verified onchain, the address merely embodies it.

# ─── KeeperHub ───────────────────────────────────────────────────────────────
# Organisation-scoped API key, `kh_` prefix. Never committed. A `wfb_` key is a
# user webhook key: rejected with a 401 by the execution routes.
KH_API_KEY=kh_xxxxxxxxxxxxxxxx
KH_BASE_URL=https://app.keeperhub.com

# ─── RPC ─────────────────────────────────────────────────────────────────────
# INDEPENDENT of KeeperHub. Using the same provider to execute and to judge
# would reintroduce the circularity the whole project exists to avoid.
BASE_RPC=https://mainnet.base.org
ETHEREUM_RPC=
# RPC published in every verdict, so that anyone can replay it.
EVALUATOR_RPC=

# ─── Escrow ──────────────────────────────────────────────────────────────────
WARRANT_ESCROW_ADDRESS=
# Chains the Gateway knows: 1, 8453, 11155111, 84532. A chain absent from the
# table fails startup — opening a warrant on the wrong chain is irreversible.
WARRANT_ESCROW_CHAIN_ID=84532
# RPC used for writes and for the startup consistency check. Empty → the chain's
# default public RPC, which rate-limits quickly.
WARRANT_ESCROW_RPC=
# Who signs `open()`: `keeperhub` (default) or `viem`.
#   keeperhub — the onchain `opener` is the KeeperHub organisation wallet and the
#               opening is gas-sponsored (docs/transactions.md § 3);
#   viem      — the `opener` is OPENER_PRIVATE_KEY, which then needs gas.
# Either way the Gateway reads `opener()` onchain at startup and refuses to start
# if what it is about to use is not what the contract expects.
WARRANT_ESCROW_PORT=keeperhub
WARRANT_TREASURY=
# Recipient of the bond on a slash — the owner of the capital. Neither the
# treasury (invariant I6: a slash earns Warrant nothing) nor the settler.
WARRANT_BENEFICIARY=
# opener and settler MUST be two distinct keys (invariant I10).
# OPENER_PRIVATE_KEY is read only when WARRANT_ESCROW_PORT=viem.
OPENER_PRIVATE_KEY=
SETTLER_PRIVATE_KEY=
FEE_BPS=250

# ─── Payment ─────────────────────────────────────────────────────────────────
X402_FACILITATOR=https://x402.org/facilitator
# Optional: some facilitators require a key.
X402_FACILITATOR_API_KEY=
# Signing secret for the MPP Challenges. The project generates it itself: nobody
# distributes it, and it serves only to let the Gateway recognise a Challenge it
# issued. One per deployment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MPP_SECRET_KEY=
# MPP payment method advertised in the Challenge. `evm` — stablecoin payments on
# EVM chains with inline x402 exact compatibility — is what this Gateway serves.
# NOT `tempo`, which is TIP-20 on the Tempo chain and a request schema we do not
# implement. Empty → `evm`.
MPP_METHOD=
# Bond token accepted by x402 settlement.
WARRANT_ASSET=
# Recipient of the x402 settlement: **the escrow itself**. `open()` requires the
# funds to be on the contract already (`token.balanceOf(this) >= totalLocked`,
# WarrantEscrow.sol:131) — an intermediate vault would add one more transfer and
# a window during which a warrant would be open without being funded.
WARRANT_PAY_TO=

# ─── Perimeter (a Gateway with a public DNS name) ────────────────────────────
# These four are inert on a laptop and load-bearing the moment the Gateway is
# reachable from the internet. Defaults are the safe ones, so an operator who
# sets nothing gets the local behaviour unchanged.
#
# Exact origins allowed to READ responses from a browser, comma-separated, with
# the scheme and no trailing slash. Empty → no CORS headers at all, which is
# what a Gateway serving only agents wants: CORS is enforced by browsers only,
# so it opens a door for a frontend and closes nothing for anyone else.
# `*` is accepted and echoes the caller's origin, but do not reach for it — an
# allowlist costs one line and survives the day a session cookie appears.
WARRANT_CORS_ORIGINS=
# Requests per minute per client address. `/healthz` is exempt, so a probe can
# never trip the limit that would then kill its own container. 0 disables the
# limiter entirely — only sensible behind another one.
WARRANT_RATE_LIMIT_RPM=60
# Ceiling on a declared request body. `POST /v1/warrants` parses attacker-supplied
# JSON; this rejects the obvious abuse before the parser sees a byte. Mirror it in
# the reverse proxy (`client_max_body_size`), which can drop the connection earlier.
WARRANT_MAX_BODY_BYTES=65536
# Read the client address from `X-Forwarded-For`. Set to `true` ONLY behind a
# reverse proxy you control: the header is caller-supplied, so trusting it on a
# directly-exposed server lets anyone forge a fresh identity per request and walk
# straight through the rate limiter. Behind nginx the inverse is true — leave it
# false and every request is attributed to the proxy, so one visitor exhausts the
# quota for everybody.
WARRANT_TRUST_PROXY=false

# ─── ERC-8004 ────────────────────────────────────────────────────────────────
# The Settler must be neither owner nor operator of the agentIds it rates,
# otherwise giveFeedback reverts (docs/10 § 4).
ERC8004_CHAIN=base
VERDICT_BASE_URI=https://raw.githubusercontent.com/<org>/<repo>/<branch>/verdicts/

# Allowed destinations for every OUTGOING category (transfer, approve, withdraw,
# borrow). MANDATORY, comma-separated: without it the Gateway refuses to start,
# and that is deliberate. An outgoing category with no allowlist produced a
# post-condition with no destination check, so a transfer to any address at all
# was honored.
WARRANT_ALLOWED_DEST=
# Tokens watched in addition to the target, for unclassified actions.
WARRANT_WATCHED_TOKENS=

# ─── Settler (settlement daemon) ─────────────────────────────────────────────
# Warrant journal, written by the Gateway and followed by the Settler. It is the
# one thing the chain cannot give back: `WarrantOpened` carries only
# `conditionHash` / `actionHash`, and a hash is not invertible. The Settler does
# not take it on trust for all that: it recomputes both commitments and refuses
# to evaluate if the journal diverges from the chain (see src/journal.ts).
WARRANT_JOURNAL_FILE=.warrant/warrants.jsonl
# Directory of the verdict documents, served as-is by the Settler at
# VERDICT_BASE_URI. The file written IS the canonical JCS form that was hashed:
# never reformat it.
# ABSOLUTE path. A relative path resolves against the process's current
# directory, and the settler is not launched from the repository root: verdicts
# committed onchain would end up outside the repository, invisible to a third
# party. `pnpm verdicts:publish` collects them back if that has happened.
VERDICT_DIR=
# Port of the read-only verdict server. VERDICT_BASE_URI must designate this
# service from the outside — that URI is what goes onchain in `feedbackURI`, and
# a URI that does not resolve makes the verdict unverifiable.
SETTLER_PORT=8403
SETTLER_INTERVAL_MS=15000
# A single pass then exit. For a cron, or to put a configuration to the test.
SETTLER_ONCE=
# Observation mode: decides, publishes, writes nothing onchain.
SETTLER_DRY_RUN=
# First block scanned. Empty → head − SETTLER_LOOKBACK_BLOCKS: a warrant lives at
# most MAX_DURATION = 7 days, so nothing older can still be Open.
SETTLER_FROM_BLOCK=
SETTLER_LOOKBACK_BLOCKS=60000
# eth_getLogs window. Public nodes cap the range (drpc: 10,000).
SETTLER_LOG_CHUNK=9000
# Depth of the archive probe at startup. The Settler refuses to start if the RPC
# cannot read at that block: judging on a non-archive node would produce
# unreplayable verdicts.
SETTLER_ARCHIVE_PROBE_DEPTH=5000
SETTLER_CONFIRMATION_TIMEOUT_MS=120000

# ERC-8004 `agent address → agentId` table, as JSON. The IdentityRegistry exposes
# no reverse lookup by owner. Absent, the warrant is still settled and the verdict
# published: only the ERC-8004 inscription is skipped.
ERC8004_AGENT_IDS_FILE=
# Inscription chain. Must be the escrow's: the Settler signs on one chain at a
# time. Empty → WARRANT_ESCROW_CHAIN_ID.
ERC8004_CHAIN_ID=
# Registry addresses. Empty → the deterministic addresses from @warrant/core,
# testnet or mainnet variant depending on the chain.
ERC8004_IDENTITY=
ERC8004_REPUTATION=
# Any chain outside the list of known testnets is treated as a mainnet, and
# writing there is REFUSED without this explicit flag.
ERC8004_ALLOW_MAINNET=
ERC8004_DISABLED=
# "every N executions or every 24 h": a slash is inscribed immediately, an
# honored warrant goes out in a batch.
ERC8004_BATCH_SIZE=25
ERC8004_BATCH_MAX_AGE_MS=86400000

# ─── Coinbase Developer Platform ─────────────────────────────────────────────
# Needed for TWO things, and that is why the account is worth the trouble:
#   1. the programmatic Base Sepolia faucet (0.1 ETH / 24 h, plus USDC);
#   2. the MAINNET x402 facilitator (api.cdp.coinbase.com/platform/v2/x402).
# The public x402.org facilitator serves Base Sepolia only: any mainnet target
# necessarily goes through CDP.
# Create one at portal.cdp.coinbase.com. Secrets: never logged.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
