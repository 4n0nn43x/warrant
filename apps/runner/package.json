{
  "name": "@warrant/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Volume runner — opens warrants continuously under an explicit budget",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "runner": "node --env-file-if-exists=../../.env --import tsx src/bin/runner.ts",
    "counters": "node --env-file-if-exists=../../.env --import tsx src/bin/counters.ts",
    "verify": "node --env-file-if-exists=../../.env --import tsx src/bin/verify.ts"
  },
  "dependencies": {
    "warrant-core": "workspace:*",
    "@warrant/server": "workspace:*",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
